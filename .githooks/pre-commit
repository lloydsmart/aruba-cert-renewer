#!/usr/bin/env bash

set -euo pipefail

branch=$(git symbolic-ref --quiet --short HEAD || true)

case "$branch" in
    main | master)
        printf 'Refusing to commit directly to protected branch: %s\n' "$branch" >&2
        printf 'Create or switch to a feature branch first.\n' >&2
        exit 1
        ;;
esac
